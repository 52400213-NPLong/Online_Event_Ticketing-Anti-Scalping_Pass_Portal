# 1. Chuỗi kết nối SQL Server qua Docker Compose (Mặc định trên cổng 1433)
ConnectionStrings__DefaultConnection="Server=localhost,1433;Database=EventTicketingDb;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=True"

# 2. Khóa bí mật HMAC-SHA256 sinh mã QR động 30s
DYNAMIC_QR_SECRET_KEY="SuperSecureHmacSecretKeyForDynamicQrTokens2026_TDTU_SE"
